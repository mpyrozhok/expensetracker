# Copy to docker/.env (beside docker-compose.yml) and fill in:
#
#   cp docker/.env.example docker/.env
#
# Compose reads this file for every subcommand, `ps` and `logs` included,
# because the whole compose file interpolates against these variables. That
# is why they live here rather than in front of a single `up` invocation.
# The real file holds secrets; .gitignore already excludes docker/.env.

# Required, no default: openssl rand -hex 32
SESSION_SECRET=

# Host port to publish. Inside the container the app always listens on 8787.
# PORT=8787

# The origin the browser actually uses. The post-login redirect target is
# allow-listed against this, so a mismatch means sign-in lands on an error.
# FRONTEND_ORIGIN=http://localhost:8787

# Real SSO. Register the callback URI at the provider as
#   <FRONTEND_ORIGIN>/api/auth/<provider>/callback
# When PORT is not 8787 you must also set the two redirect URIs to that same
# value: the defaults are built from the port the app listens on inside the
# container, which PORT does not change.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
# GITHUB_REDIRECT_URI=http://localhost:8787/api/auth/github/callback

# 1 turns on the stub sign-in form, which is how you get in without provider
# credentials. Leave it unset (0) for a real deployment.
# ALLOW_MOCK_AUTH=0
