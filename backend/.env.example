# ---------------------------------------------------------------------------
# Expense Tracker — backend environment
# Copy to backend/.env and fill in what you need. The backend reads real
# environment variables; start the app with:  set -a && . ./.env && set +a
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
# Signed session cookie secret. REQUIRED in production.
# Generate: openssl rand -hex 32
SESSION_SECRET=dev-insecure-session-secret-change-me-0123456789abcdef
# Session lifetime in seconds (default 30 days -> survives page refresh + restart)
SESSION_TTL_SECONDS=2592000
# SQLite file location (created automatically)
DATABASE_PATH=./data/app.db
# Origin of the SPA; used for the post-SSO redirect and as a redirect allow-list entry
FRONTEND_ORIGIN=http://localhost:5173
# Set true only when serving over https
COOKIE_SECURE=false

# --- Google OAuth / OpenID Connect -----------------------------------------
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: http://localhost:8787/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
# Optional overrides (used by the offline test stub)
# GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# GOOGLE_SCOPES="openid profile email"

# --- GitHub OAuth -----------------------------------------------------------
# Settings: https://github.com/settings/developers
# Authorization callback URL to register: http://localhost:8787/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8787/api/auth/github/callback
# GITHUB_SCOPES="read:user user:email"

# --- Local evaluation -------------------------------------------------------
# Enables POST /api/auth/mock/login (stub SSO) so the app can be evaluated with
# no Google/GitHub credentials, and powers the automated test suite.
# MUST be 0/false in production.
ALLOW_MOCK_AUTH=1

# --- Production single-process mode ----------------------------------------
# When set and the directory exists, Express serves the built SPA from here.
# STATIC_DIR=../frontend/dist
